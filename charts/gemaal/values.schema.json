{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gemaal chart values",
  "description": "Strict at the top level: unknown keys are rejected so a typo fails the render instead of being silently ignored. The service config document (config) is rendered verbatim and stays open; Kubernetes passthrough fields too.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "resources": { "type": "object" },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "exposure": {
      "type": "object",
      "description": "Documentation-only: browser exposure is gateway-owned (expose-a-ui pattern); these values let a deployment's values file record the hostname next to the app.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "hostname": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "sweep": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "confirm": { "type": "boolean" },
    "config": {
      "type": "object",
      "description": "The service configuration document, rendered verbatim — see config.example.yaml. Keep it free of a dryRun key: that line is rendered from `confirm`."
    }
  }
}
