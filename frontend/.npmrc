# @truvity/access-roster ships to GitHub Packages, which refuses anonymous
# installs even for a public package: export GITHUB_PACKAGES_TOKEN (a token
# with read:packages, e.g. `gh auth token`) before `npm install`.
@truvity:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_PACKAGES_TOKEN}
